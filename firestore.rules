rules_version = '2';

// Placeholder rules — deny everything until the data model + auth flow
// (synthesized-email Firebase Auth, see SPEC.md) are actually wired up.
// Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
